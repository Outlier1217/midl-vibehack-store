# .gitignore file create karo
cat > .gitignore << EOF
# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
out/
dist/

# Environment
.env
.env.local
.env.production

# Cache
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Next.js
.cache/
.vercel
EOF